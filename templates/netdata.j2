{{ '## netdata.conf' }}
{{ '# ' + ansible_managed }}
{{ '# Do not edit manually' }}

{% for n in lookup('ansible.builtin.vars', 'netdata_settings') %}
{% if n['global'] is defined and n['global'] not in ['', [], '[]', None] %}
{{ '[global]' }}
{% for ng in n['global'] %}
{% for k,v in ng.items() %}
{% if v is defined and v not in ['', [], '[]', None] %}
{{ '  ' + k | replace('_', ' ') + ' = ' + v }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if n['db'] is defined and n['db'] not in ['', [], '[]', None] %}
{{ '[db]' }}
{% for nd in n['db'] %}
{% for k,v in nd.items() %}
{% if v is defined and v not in ['', [], '[]', None] %}
{{ '  ' + k | replace('_', ' ') + ' = ' + v }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if n['plugins'] is defined and n['plugins'] not in ['', [], '[]', None] %}
{{ '[plugins]' }}
{% for np in n['plugins'] %}
{% for k,v in np.items() %}
{% if v is defined and v not in ['', [], '[]', None] %}
{{ '  ' + k | replace('_', ' ') + ' = ' + v }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% if n['plugin'] is defined and n['plugin'] not in ['', [], '[]', None] %}
{% for np in n['plugin'] %}
{% for k,v in np.items() %}
{% if k == 'path' %}
{{ '[plugin:' + v + ']' }}
{% else %}
{% if v is defined and v not in ['', [], '[]', None] %}
{{ '  ' + k | replace('_', ' ') + ' = ' + v }}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
